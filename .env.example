# Default: genuine ONNX inference entirely in the browser; uploaded images remain local.
# Optional: HTTPS URL of the FastAPI research service, without a trailing slash.
# NEXT_PUBLIC variables are embedded at build time and must never contain secrets.
NEXT_PUBLIC_INFERENCE_URL=

# Optional backend-only configuration, read when the FastAPI service starts.
MODEL_CHECKPOINT=models/skinsnap_derma_cnn.pt
MODEL_MANIFEST=public/model/manifest.json
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
